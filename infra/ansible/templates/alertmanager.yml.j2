global:
  resolve_timeout: 5m
  smtp_smarthost: "{{ monitoring_alert_smtp_smarthost }}"
  smtp_from: "{{ monitoring_alert_email_from }}"
  smtp_auth_username: "{{ monitoring_alert_smtp_auth_username }}"
  smtp_auth_identity: "{{ monitoring_alert_smtp_auth_username }}"
  smtp_auth_password: "{{ monitoring_alert_smtp_auth_password }}"
  smtp_require_tls: true

route:
  receiver: gmail
  group_by:
    - alertname
    - job
    - instance
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: gmail
    email_configs:
      - to: "{{ monitoring_alert_email_to }}"
        send_resolved: true
