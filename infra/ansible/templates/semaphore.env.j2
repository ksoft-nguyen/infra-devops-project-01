# Semaphore UI storage and execution configuration
SEMAPHORE_IMAGE={{ semaphore_image }}
SEMAPHORE_DB_DIALECT=sqlite
SEMAPHORE_PLAYBOOK_PATH=/tmp/semaphore

# Initial administrator account
SEMAPHORE_ADMIN={{ semaphore_admin_user }}
SEMAPHORE_ADMIN_NAME={{ semaphore_admin_name }}
SEMAPHORE_ADMIN_EMAIL={{ semaphore_admin_email }}
SEMAPHORE_ADMIN_PASSWORD_FILE=/run/secrets/semaphore_admin_password

# Used to encrypt credentials held in Semaphore's key store.
SEMAPHORE_ACCESS_KEY_ENCRYPTION_FILE=/run/secrets/semaphore_access_key_encryption
SEMAPHORE_LDAP_ACTIVATED=no
TZ={{ semaphore_timezone }}
