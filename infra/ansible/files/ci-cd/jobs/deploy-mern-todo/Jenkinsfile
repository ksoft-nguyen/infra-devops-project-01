pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }

  stages {
    stage('Deploy') {
      steps {
        sh '''#!/bin/sh
set -eu

deploy_script="infra/ansible/files/ci-cd/scripts/deploy.sh"

echo "Jenkins workspace: ${WORKSPACE}"
echo "Looking for deploy script: ${deploy_script}"

if [ ! -f "${deploy_script}" ]; then
  echo "Deploy script was not found." >&2
  echo "Current directory: $(pwd)" >&2
  echo "Repository files at workspace root:" >&2
  find . -maxdepth 4 -type f | sort >&2
  exit 1
fi

sh "${deploy_script}"
'''
      }
    }
  }
}
